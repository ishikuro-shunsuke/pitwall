{
  "name": "pitwall",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [4477],
  "appPort": [4477],
  "portsAttributes": {
    "4477": {
      "label": "pitwall",
      "onAutoForward": "notify"
    }
  },
  "runArgs": ["--name", "pitwall", "--add-host=host.docker.internal:host-gateway"],
  "mounts": [
    "source=pitwall-gh,target=/home/node/.config/gh,type=volume",
    "source=pitwall-claude,target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "EDITOR": "code",
    "GIT_EDITOR": "code --wait"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
